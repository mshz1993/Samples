@model string

@if (!String.IsNullOrEmpty(Model))
{
    var statusMessageClass = Model.StartsWith("Error") ? "danger" : "success";
    <div class="alert alert-@statusMessageClass alert-dismissible" id="myDIV" role="alert" dir="rtl" style="text-align:center">
        <button type="button"  class="close" data-dismiss="alert" aria-label="Close" onclick="myFunction()"><span aria-hidden="true">&times;</span></button>
        @Model
    </div>
}


    <script>
        function myFunction() {
            var x = document.getElementById("myDIV");
            if (x.style.display === "none") {
                x.style.display = "block";
            } else {
                x.style.display = "none";
            }
        }
    </script>