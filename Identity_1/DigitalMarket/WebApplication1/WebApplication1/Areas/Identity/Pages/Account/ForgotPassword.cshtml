@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "فراموشی رمز عبور";
    Layout = "~/Views/Shared/Index_Layout.cshtml";
}


<div class="row" style="margin-left: 600px;text-align:center;padding: 40px;">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Input.Email"></label>
                <input asp-for="Input.Email" class="form-control" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div>
                <button type="submit" class="boxed-btn4" style="margin-left: 20px;margin: 10px">ثبت</button>
            </div>
        </form>
    </div>
</div>

