@page
@model IndexModel
@{
    ViewData["Title"] = "اطلاعات کاربری";
    ViewData["ActivePage"] = ManageNavPages.Index;
    Layout = "~/Views/Shared/UserAdmin_LayoutPage.cshtml";
}

<partial name="_StatusMessage" for="StatusMessage" />
<div style="height:1000px">
    <div style="padding:70px;box-shadow: 0 0 10px 1px #afafaf;direction:rtl;width:fit-content; border-radius:50px;margin-left: 500px;margin-top:100px;text-align:center">
        <h2 style="text-align:center;padding-bottom:50px;color:red">تغییراطلاعات کاربری</h2>
        <form id="profile-form" method="post">
            <div asp-validation-summary="All" class="text-danger" style="padding-bottom:20px"></div>
            <div class="form-group">
                <label asp-for="Username"></label>
                <input asp-for="Username" class="form-control" disabled />
            </div>
            <div class="form-group">
                <label asp-for="Input.Email"></label>
                @if (Model.IsEmailConfirmed)
                {
                    <div class="input-group">
                        <input asp-for="Input.Email" class="form-control" />
                        <span class="input-group-addon" aria-hidden="true"><span class="glyphicon glyphicon-ok text-success"></span></span>
                    </div>
                }
                else
                {
                    <input asp-for="Input.Email" class="form-control" />
                    <button id="email-verification" type="submit" asp-page-handler="SendVerificationEmail" class="btn btn-link" style="background-color: deepskyblue; color: white;margin-top: 10px;">ارسال ایمیل تایید</button>
                }
                </br>
              
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Input.PhoneNumber"></label>
                <input asp-for="Input.PhoneNumber" class="form-control" />
                <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
            </div>
            <button id="update-profile-button" type="submit" class="boxed-btn4" style="margin-left: 20px">ذخیره</button>
        </form>
    </div>
</div>

