@page
@model RegisterModel
@{
    ViewData["Title"] = "ثبت نام کاربر";
    Layout = "~/Views/Shared/Index_Layout.cshtml";
    TempData["RequestedPage"] = Request.Headers["Referer"].ToString();
}

<form asp-route-returnUrl="@Model.ReturnUrl" method="post" autocomplete="off">
    <div style="margin-bottom:100px ;">
        <div style="padding:70px;text-align:center;box-shadow: 0 0 10px 1px #afafaf;direction:rtl;width:fit-content; border-radius:50px;margin-left: 600px;margin-top:100px">
            <h2 style="text-align:center;padding-bottom:50px;color:red">ثبت نام کاربر</h2>

            <div asp-validation-summary="All"  class="text-danger" style="text-align: center;padding-bottom: 10px; padding: 15px; margin-bottom: 20px;"></div>
            <div class="form-group">
                <label asp-for="Input.Email" class="control-label"></label>
                <input asp-for="Input.Email" class="form-control" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Input.Password" class="control-label"></label>
                <input asp-for="Input.Password" class="form-control" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            <div style="margin:10px">
                <label asp-for="Input.ConfirmPassword" class="control-label"></label>
                <input asp-for="Input.ConfirmPassword" class="form-control" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>
            <button type="submit" class="boxed-btn4" style="width:200px;margin-left: 0px;margin-top:30px">ثبت</button>
        </div>
    </div>
</form>
  

