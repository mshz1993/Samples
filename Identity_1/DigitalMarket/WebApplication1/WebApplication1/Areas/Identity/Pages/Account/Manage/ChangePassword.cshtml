@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "تغییر کلمه عبور";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
    Layout = "~/Views/Shared/UserAdmin_LayoutPage.cshtml";
}

<partial name="_StatusMessage" for="StatusMessage" />
<div style="height:1000px">
    <div style="padding:70px;box-shadow: 0 0 10px 1px #afafaf;direction:rtl;width:fit-content; border-radius:50px;margin-left: 500px;margin-top:70px;text-align:center">
        <h2 style="text-align:center;padding-bottom:50px;color:red">تغییر کلمه عبور</h2>
        <form id="change-password-form" method="post">
            <div asp-validation-summary="All" class="text-danger" style="background-color: darkturquoise; color: black!important"></div>
            <div class="form-group" style="padding-top: 30px;">
                <label asp-for="Input.OldPassword"></label>
                <input asp-for="Input.OldPassword" class="form-control" />
                <span asp-validation-for="Input.OldPassword" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Input.NewPassword"></label>
                <input asp-for="Input.NewPassword" class="form-control" />
                <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Input.ConfirmPassword"></label>
                <input asp-for="Input.ConfirmPassword" class="form-control" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>
            <button type="submit" class="boxed-btn4" style="margin-left: 20px">ثبت</button>
        </form>
    </div>
</div>

