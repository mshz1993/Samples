@page
@model LoginModel

@{
    ViewData["Title"] = "ورود به سیستم";
    Layout = "~/Views/Shared/Index_Layout.cshtml";
}


<div class="row" style="padding: 10px;margin-left: 600px;text-align: center">
    <div class="col-md-4">
        <section>
            <form id="account" method="post">
                <div asp-validation-summary="All" class="text-danger"></div>
                <div>
                    <label asp-for="Input.Email"></label>
                    <input asp-for="Input.Email" class="form-control" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <div>
                    <label asp-for="Input.Password"></label>
                    <input asp-for="Input.Password" class="form-control" />
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
                <div>
                    <div class="checkbox" style="padding-top: 10px">
                        <label asp-for="Input.RememberMe">
                            <input asp-for="Input.RememberMe" />
                            @Html.DisplayNameFor(m => m.Input.RememberMe)
                        </label>
                    </div>
                </div>
                <div>
                    <button type="submit" class="boxed-btn4" style="margin-left: 20px;margin: 10px">ورود</button>
                </div>
                <div>
                    <p style="background-color: aquamarine">
                        <a id="forgot-password" asp-page="./ForgotPassword">کلمه عبور را فراموش کرده ام</a>
                    </p>
                    <p style="background-color: darkorange; margin-top: 10px">
                        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">ثبت نام</a>
                    </p>
                </div>
            </form>
        </section>
    </div>
