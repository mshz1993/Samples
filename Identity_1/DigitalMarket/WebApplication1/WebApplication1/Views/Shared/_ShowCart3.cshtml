@model IEnumerable<WebApplication1.Models.ViewModels.ShowCartViewModel>
@{int Totalprice = 0; }
@if (Model.Any())
{
    @foreach (var item in Model)
    {
        <div>
            <img src="~/images/DigitalPro/@item.ImageName" style="width:90px;height:60px" />
            <span style="font-size: small;font-weight: 400; width:150px;text-align:right!important">@item.Title </span>

        </div>
        <div style="padding-bottom:20px;padding-top:15px;">
             <span class="badge" style="font-size: small;padding-left: 50%; font-weight: 400;text-align:center">تعداد: @item.Count</span>
             <a style="text-decoration: blink;font-size: 20px; color : #e442e6;" asp-controller="Orders" asp-action="Delete" asp-route-id=@item.ProdectId>
                 <img src="~/images/delete_286553.png" style="width:15px" />
             </a>
        
        </div>
        Totalprice = Totalprice + Convert.ToInt32(item.Price) * Convert.ToInt32(item.Count);

    }
}
else
{
    <p> سبد خرید خالی است </p>
}
@if (Model.Any())
{
    <hr />
    <div>
        @{string text = string.Format("{0:N0}", Convert.ToDecimal(Totalprice)); }
       مبلغ قابل پرداخت:  @text تومان
    </div>
    <div style="margin-top:50px;">
        <a href="https://localhost:44333/home/shopingcart" style="background: #FF4A52;  color: #fff; padding: 10px;font-size: 16px; font-weight: 500">نمایش فاکتور</a>
    </div>
}




