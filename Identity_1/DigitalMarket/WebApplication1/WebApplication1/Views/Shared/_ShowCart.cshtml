@model IEnumerable<WebApplication1.Models.ViewModels.ShowCartViewModel>
<link rel="stylesheet" href="~/css/Cartstyle.css" media="screen" title="no title" charset="utf-8">
<script src="https://code.jquery.com/jquery-2.2.4.js" charset="utf-8"></script>
<link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">

<div class="shopping-cart" dir="rtl" style="text-align:center;box-shadow: 0 0 10px 1px #afafaf;font-family:IRANSansWeb(FaNum)">

    <div class="title">
        سبد خرید
    </div>

    @if (Model.Any())
    {
        @foreach (var item in Model)
        {
            <div class="item">
                <div class="image">
                    <img src="~/images/destination/@item.ImageName" class="thumbnail" width="120px" height="80px" />
                </div>
                <div class="description">
                    <span style="font-size: initial;font-weight: 400">@item.Title <span class="badge" style="font-size: initial;font-weight: 400">@item.Count</span></span>
                </div>
                <div class="quantity">
                    <a class="material-icons" style="text-decoration: blink;font-size: 20px;color: #e442e6;" asp-controller="Orders" asp-action="AddToCart" asp-route-id=@item.ProdectId>
                        &#xe3ba;
                    </a>
                    <input type="text" name="name" value="1" readonly="readonly">
                    <a class="material-icons" style="text-decoration: blink;font-size: 20px;color: #e442e6;" asp-controller="Orders" asp-action="AddToCart" asp-route-id=@item.ProdectId asp-route-Negetive=1>
                        &#xe15d;
                    </a>
                </div>
                @*<div class="total-price"></div>*@
                <div class="buttons" style="margin-top: -8px">
                    <a class="material-icons" style="text-decoration: blink;font-size: 20px;color: #e442e6;" asp-controller="Orders" asp-action="DeleteFromCart" asp-route-id=@item.ProdectId>
                        &#xe14c;
                    </a>
                </div>
            </div>






        }
    }
    else
    {
        <p> سبد خرید خالی است </p>
    }
    @if (Model.Any())
    {
        <div style="margin-top:50px;">
            <a style="background: #FF4A52;  color: #fff; padding: 13px 39px;font-size: 16px; font-weight: 500">نمایش فاکتور</a>
        </div>
    }


</div>


