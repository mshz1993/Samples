                                    <a href="https://localhost:44333/Identity/Account/Manage">اطلاعات کاربری</a>
                                    <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout"
                                          asp-route-returnUrl="@Url.Page("/", new { area = "" })"
                                          method="post">
                                        {  <input type="submit" value="خروج" style="border-style:none" /> }

                                    </form>
                                </div>
                            }
                        </div>
