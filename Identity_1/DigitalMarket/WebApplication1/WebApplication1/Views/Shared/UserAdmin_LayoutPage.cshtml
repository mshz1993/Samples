                        <li class="fas fa-th-large"></li>
                    </a>
                </ul>
                <ul style="margin-top: auto; margin-right: 500px;display:flex">
                    <li style="padding-left: 25px"><a href="/Home/Index"> صفحه اصلی</a></li>
                    <li style="padding-left: 25px"><a href="https://localhost:44333/Identity/Account/Register">ثبت نام کاربر</a></li>
