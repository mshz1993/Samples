                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="/User/ManageAudioMusic" class="nav-link">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>مدیریت</p>
                                    </a>
                                </li>

                            </ul>
                        </li>

                        <li class="nav-item has-treeview">
                            <a href="#" class="nav-link">
                                <i class="nav-icon fas fa-check"></i>
                                <p>
